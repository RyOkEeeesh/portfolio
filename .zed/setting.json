{
  "formatter": {
    "external": {
      "command": "pnpm",
      "arguments": ["exec", "biome", "format", "--stdin-file-path", "{buffer_path}"]
    }
  },

  "languages": {
    "Astro": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "prettier", "--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  }
}
