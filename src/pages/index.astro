---
import type { Thing, WithContext } from 'schema-dts';
import AboutCard from '@/components/parts/card/AboutCard/index.astro';
import ContentCard from '@/components/parts/card/ContentCard/index.astro';
import Layout from '@/layouts/Layout/index.astro';

import { ContentsSchema } from '@/schema/posts';

const jsonld: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'kaji',
  url: 'https://kaji.blog',
  sameAs: ['https://github.com/RyOkEeeesh'],
  jobTitle: 'Student',
};
---

<Layout jsonld={jsonld}>
  <main>
    <AboutCard />
    {ContentsSchema.options.map(route => (<ContentCard route={route} />))}
    <ContentCard route='tags' />
  </main>
</Layout>
