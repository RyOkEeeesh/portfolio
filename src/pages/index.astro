---
import type { Thing, WithContext } from 'schema-dts';
import GithubIcon from '@/components/GithubIcon.astro';
import Title from '@/components/Title.astro';
import Layout from '@/layouts/Layout.astro';

const jsonld: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'kaji',
  url: 'https://kaji.blog',
  sameAs: ['https://github.com/RyOkEeeesh'],
  jobTitle: 'Student',
};
---

<Layout jsonld={jsonld}>
  <main>
    <article>
      <p><span class="sub-txt">Developer · Student</span></p>
      <section>
        <div class="">
          <a href="/about">
            <div class="">
              <GithubIcon />
            </div>
            <div class="">
              <p>加地 良寅 <span>Kaji Ryoin</span></p>
              <p>HAL東京</p>
              <p><a href="https://github.com/RyOkEeeesh" target="_blank" rel="noopener noreferrer">GitHub</a></p>
            </div>
          </a>
        </div>
      </section>
    </article>
    <article>
      <Title>Project</Title>
    </article>
    <article>
      <Title>Blog</Title>
    </article>
    <article>
      <Title>Note</Title>
    </article>
    <article>
      <Title>Tags</Title>
    </article>
  </main>
</Layout>
