---
import type { Thing, WithContext } from 'schema-dts';
import AboutCard from '@/components/parts/card/AboutCard/index.astro';
import Title from '@/components/Title/index.astro';
import Layout from '@/layouts/Layout/index.astro';

const jsonld: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'kaji',
  url: 'https://kaji.blog',
  sameAs: ['https://github.com/RyOkEeeesh'],
  jobTitle: 'Student',
};
---

<Layout jsonld={jsonld}>
  <main>
    <AboutCard />
    <section>
      <Title>Project</Title>
    </section>
    <section>
      <Title>Blog</Title>
    </section>
    <section>
      <Title>Note</Title>
    </section>
    <section>
      <Title>Tags</Title>
    </section>
  </main>
</Layout>
