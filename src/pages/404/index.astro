---
import Layout from '@/layouts/Layout/index.astro';
---

<Layout title="404 Not Found" noindex>
  <main class="not-found">
    <span class="code sub">404</span>
    <h2 class="title">Page Not Found</h2>
    <p class="desc sub">The page you are looking for does not exist or has been moved.</p>
    <a class="home-btn sub" href="/">Back to Home</a>
  </main>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.85rem;
    padding: 5rem 1rem;
  }

  .code {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--clr-txt-main);
  }

  .title {
    font-size: var(--font-size-mut-title-m);
    font-weight: 700;
  }

  .desc {
    font-size: var(--font-size-mut-txt-m);
    margin-bottom: 0.75rem;
  }

  .home-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--clr-border);
    background-color: var(--clr-bg-surface);
    color: var(--clr-txt-main);
    font-size: var(--font-size-mut-txt-s);
    transition:
      border-color var(--duration-common),
      background-color var(--duration-common),
      transform var(--duration-common);

    &:hover {
      border-color: var(--clr-border-active);
      background-color: var(--clr-bg-subtle);
      transform: translateY(-2px);
    }
  }
</style>
