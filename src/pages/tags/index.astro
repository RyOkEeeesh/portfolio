---
import Title from '@/components/Title.astro';
import Layout from '@/layouts/Layout.astro';
import { getTags } from '@/lib';

const tags = await getTags();
---

<Layout title={"タグ一覧"}>
  <main>
    <a href="/">← トップへ戻る</a>
    <Title>タグ一覧</Title>
    {
      tags.length === 0 ? (
        <p>タグがありません。</p>
      ) : (
        <ul>
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}`}>{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
