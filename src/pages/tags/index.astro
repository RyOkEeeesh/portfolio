---
import Layout from '@/layouts/Layout/index.astro';

import Title from '@/components/Title/index.astro';
import Back from '@/components/parts/btn/Back/index.astro';

import { getTags } from '@/lib';

const tags = await getTags();
---

<Layout title={"タグ一覧"}>
  <main>
    <Back href="/" />
    <Title>タグ一覧</Title>
    {
      tags.length === 0 ? (
        <p>タグがありません。</p>
      ) : (
        <ul>
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}`}>{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
