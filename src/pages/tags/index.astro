---
import Layout from '@/layouts/Layout/index.astro';

import Back from '@/components/parts/link/Back/index.astro';
import Title from '@/components/parts/Title/index.astro';

import { getTags } from '@/lib';

const tags = await getTags();
---

<Layout title="tags">
  <main class="tags-page">
    <Back href="/" />
    <header class="page-header">
      <Title>tags</Title>
      <span class="count sub">{tags.length} {tags.length === 1 ? 'tag' : 'tags'}</span>
    </header>
    {
      tags.length === 0 ? (
        <div class="empty-state sub">No tags yet.</div>
      ) : (
        <ul class="tag-list">
          {tags.map(tag => (
            <li>
              <a class="tag-chip" href={`/tags/${tag.name}`}>
                <span class="tag-name sub">#{tag.name}</span>
                <span class="tag-count sub">{tag.count}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>

<style>
  .tags-page {
    display: flex;
    flex-direction: column;
  }

  .page-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--clr-border);
  }

  .count {
    font-size: var(--font-size-mut-txt-s);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--clr-border);
    background-color: var(--clr-bg-surface);
    box-shadow: 0 1px 4px var(--clr-shadow);
    transition:
      border-color var(--duration-common),
      background-color var(--duration-common),
      transform var(--duration-common);

    &:hover {
      border-color: var(--clr-border-active);
      background-color: var(--clr-bg-subtle);
      transform: translateY(-2px);
    }
  }

  .tag-name {
    color: var(--clr-txt-main);
    font-size: var(--font-size-mut-txt-m);
    font-weight: 500;
  }

  .tag-count {
    font-size: var(--font-size-mut-txt-s);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background-color: var(--clr-bg-subtle);
    border: 1px solid var(--clr-border);
    line-height: 1.3;
  }

  .empty-state {
    padding: 3rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px dashed var(--clr-border);
    text-align: center;
    font-size: var(--font-size-mut-txt-m);
  }
</style>
