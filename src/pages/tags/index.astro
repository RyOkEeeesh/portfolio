---
import { getTags } from '@/lib';

import Layout from '@/layouts/Layout/index.astro';

import Back from '@/components/parts/link/Back/index.astro';
import Title from '@/components/parts/Title/index.astro';

const tags = await getTags();
---

<Layout title={'タグ一覧'}>
  <main>
    <Back href="/" />
    <Title>タグ一覧</Title>
    {
      tags.length === 0 ? (
        <p>タグがありません。</p>
      ) : (
        <ul>
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag.name}`}>
                {tag.count}
                {tag.name}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
