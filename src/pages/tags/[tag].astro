---
import Post from '@/components/Post.astro';
import Title from '@/components/Title.astro';
import Layout from '@/layouts/Layout.astro';
import { getPosts, getTags } from '@/lib';

export async function getStaticPaths() {
  const allPost = await getPosts();
  const tags = await getTags();

  return tags.map(tag => {
    const posts = allPost.filter(post => post.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts, tag },
    };
  });
}

const { posts, tag } = Astro.props;
---

<Layout title={tag}>
  <main>
    <a href="/tags">← タグ一覧</a>
    <Title>{tag}</Title>
    {
      posts.length === 0 ? (
        <p>記事がありません。</p>
      ) : (
        <article>
          {posts.map((post) => (
            <Post post={post} />
          ))}
        </article>
      )
    }
  </main>
</Layout>