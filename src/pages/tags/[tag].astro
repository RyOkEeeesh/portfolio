---
import Layout from '@/layouts/Layout/index.astro';

import PostCard from '@/components/parts/card/PostCard/index.astro';
import Title from '@/components/Title/index.astro';
import Back from '@/components/parts/btn/Back/index.astro';

import { getPosts, getTags } from '@/lib';

export async function getStaticPaths() {
  const allPost = await getPosts();
  const tags = await getTags();

  return tags.map(tag => {
    const posts = allPost.filter(post => post.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts, tag },
    };
  });
}

const { posts, tag } = Astro.props;
---

<Layout title={tag}>
  <main>
    <Back href='/tags' />
    <Title>{tag}</Title>
    {
      posts.length === 0 ? (
        <p>記事がありません。</p>
      ) : (
        <article>
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </article>
      )
    }
  </main>
</Layout>