---
import { SITE_DATA } from '@/data/index.ts';

import Layout from '@/layouts/Layout/index.astro';

import GithubIcon from '@/components/parts/image/GithubIcon/index.astro';
---

<Layout title="プロファイル">
  <main>
    <section>
      <!-- 自己紹介 -->
      <div class="center">
        <GithubIcon />
        <p>{`${SITE_DATA.user.name.last} ${SITE_DATA.user.name.first}`}</p>
        <div class="external-links">
          <a href="https://github.com/RyOkEeeesh" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
