---
import { fmtDate } from '@/utils';
import { getImgName } from '@/utils/page';
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import Layout from '@/layouts/Layout/index.astro';

import Back from '@/components/parts/link/Back/index.astro';
import Title from '@/components/parts/Title/index.astro';

import { getPosts } from '@/lib';
import { ELEMENTS } from '@/constants';

import thumbnail from '@/assets/thumbnail.png';

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map(post => ({
    params: {
      route: post.data.contentType,
      id: post.id,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <main class="post-detail">
    <Back />
    <article class="post-article">
      <div class="hero-thumb">
        {
          typeof (post.data.thumbnail || thumbnail) === 'string' ? (
            <Image
              class={ELEMENTS.POST_IMG}
              src={(post.data.thumbnail || thumbnail) as string}
              alt={`${post.data.title}のサムネイル`}
              width={1200}
              height={630}
              loading="eager"
              transition:name={getImgName(post)}
            />
          ) : (
            <Image
              class={ELEMENTS.POST_IMG}
              src={(post.data.thumbnail || thumbnail) as ImageMetadata}
              alt={`${post.data.title}のサムネイル`}
              loading="eager"
              transition:name={getImgName(post)}
            />
          )
        }
      </div>

      <header class="post-header">
        <div class="post-meta">
          <span class="type-badge sub">{post.data.contentType}</span>
          <time class="post-date sub" datetime={post.data.createdAt}>
            {fmtDate(post.data.createdAt)}
          </time>
        </div>

        <Title>{post.data.title}</Title>

        {
          post.data.tags.length > 0 && (
            <ul class="post-tags">
              {post.data.tags.map(tag => (
                <li>
                  <a class="tag-pill sub" href={`/tags/${tag.name}`}>
                    #{tag.name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="markdown-body">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  .post-detail {
    display: flex;
    flex-direction: column;
  }

  .post-article {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .hero-thumb {
    width: 100%;
    aspect-ratio: 1200 / 630;
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-border);
    background-color: var(--clr-bg-subtle);
    overflow: hidden;
    box-shadow: 0 2px 12px var(--clr-shadow);

    :global(.post-img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--clr-border);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--font-size-mut-txt-s);
  }

  .type-badge {
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--clr-border);
    background-color: var(--clr-bg-surface);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.25rem;
  }

  .tag-pill {
    display: inline-block;
    font-size: var(--font-size-mut-txt-s);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--clr-border);
    background-color: var(--clr-bg-surface);
    transition:
      border-color var(--duration-common),
      background-color var(--duration-common),
      color var(--duration-common);

    &:hover {
      border-color: var(--clr-border-active);
      background-color: var(--clr-bg-subtle);
      color: var(--clr-txt-main);
    }
  }

  /* Markdown Body Styling */
  .markdown-body {
    line-height: 1.85;
    font-size: 1rem;
    color: var(--clr-txt-main);
    word-break: break-word;

    :global(h1),
    :global(h2),
    :global(h3),
    :global(h4),
    :global(h5),
    :global(h6) {
      font-family: var(--font-title);
      font-weight: 700;
      line-height: 1.4;
      margin-top: 2.25rem;
      margin-bottom: 0.85rem;
      color: var(--clr-txt-main);
    }

    :global(h2),
    :global(h3) {
      font-size: 1.35rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--clr-border);
    }

    :global(h4) {
      font-size: 1.15rem;
    }

    :global(h5),
    :global(h6) {
      font-size: 1rem;
      color: var(--clr-txt-sub);
    }

    :global(p) {
      margin: 1rem 0;
    }

    :global(a) {
      color: var(--clr-txt-main);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: var(--clr-border-active);
      transition: text-decoration-color var(--duration-common);

      &:hover {
        text-decoration-color: var(--clr-txt-main);
      }
    }

    :global(ul),
    :global(ol) {
      margin: 1rem 0;
      padding-left: 1.5rem;
    }

    :global(ul li) {
      list-style: disc;
      margin: 0.35rem 0;
    }

    :global(ol li) {
      list-style: decimal;
      margin: 0.35rem 0;
    }

    :global(li.task-list-item) {
      list-style: none;
      margin-left: -1.25rem;
    }

    :global(blockquote) {
      margin: 1.25rem 0;
      padding: 0.75rem 1.25rem;
      border-left: 3px solid var(--clr-border-active);
      background-color: var(--clr-bg-subtle);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      color: var(--clr-txt-sub);

      :global(p) {
        margin: 0.25rem 0;
      }
    }

    :global(:not(pre) > code) {
      font-family: var(--font-sub);
      font-size: 0.875em;
      padding: 0.15em 0.4em;
      border-radius: 4px;
      background-color: var(--clr-bg-subtle);
      border: 1px solid var(--clr-border);
    }

    :global(hr) {
      border: none;
      border-top: 1px solid var(--clr-border);
      margin: 2rem 0;
    }

    :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-size: 0.925rem;
      overflow-x: auto;
      display: block;
    }

    :global(th),
    :global(td) {
      padding: 0.65rem 0.9rem;
      border: 1px solid var(--clr-border);
      text-align: left;
    }

    :global(th) {
      background-color: var(--clr-bg-subtle);
      font-weight: 700;
    }

    :global(img),
    :global(video) {
      margin: 1.5rem auto;
      border-radius: var(--radius-md);
      border: 1px solid var(--clr-border);
    }

    :global(svg.flowchart),
    :global(svg[id^='mermaid-']) {
      margin: 1.75rem auto;
      padding: 1.25rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--clr-border);
      background-color: #ffffff;
    }
  }
</style>
