---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import thumbnail from '@/assets/thumbnail.png';
import Title from '@/components/Title/index.astro';
import Layout from '@/layouts/Layout/index.astro';
import { getImgName, getPosts } from '@/lib';

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map(post => ({
    params: {
      route: post.data.contentType,
      id: post.id,
    },
    props: { post },
  }));
}

const { route } = Astro.params;
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <main>
    <button type="button" class="back-link" data-route={`/${route}`} />
    <article class="markdown-body">
      <Image
        class="post-img"
        src={post.data.thumbnail ?? thumbnail}
        alt={`${post.id}のサムネイル`}
        loading="eager"
        inferSize
        transition:name={getImgName(post)}
      />
      <span>{post.data.createdAt.toLocaleDateString()}</span>
      <Title>{post.data.title}</Title>
      <Content />
    </article>
  </main>
  
  <script>
    document.addEventListener("astro:page-load", () => {
      const backButton = document.querySelector(".back-link") as HTMLButtonElement | null;
      if (!backButton) return;

      backButton.addEventListener("click", e => {
        e.preventDefault();

        const defaultRoute = backButton.dataset.route || "/";
        const referrer = document.referrer;

        if (referrer && new URL(referrer).origin === window.location.origin) {
          history.back();
        } else {
          window.location.href = defaultRoute;
        }
      });
    });
  </script>
</Layout>