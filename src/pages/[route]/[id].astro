---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import Layout from '@/layouts/Layout/index.astro';

import Back from '@/components/parts/link/Back/index.astro';
import Title from '@/components/parts/Title/index.astro';

import { getImgName, getPosts } from '@/lib';
import { ELEMENTS } from '@/constants';

import thumbnail from '@/assets/thumbnail.png';

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map(post => ({
    params: {
      route: post.data.contentType,
      id: post.id,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <main>
    <Back />
    <article class="markdown-body">
      {
        typeof (post.data.thumbnail || thumbnail) === 'string' ? (
          <Image
            class={ELEMENTS.POST_IMG}
            src={(post.data.thumbnail || thumbnail) as string}
            alt={`${post.data.title}のサムネイル`}
            width={800}
            height={450}
            loading="eager"
            transition:name={getImgName(post)}
          />
        ) : (
          <Image
            class={ELEMENTS.POST_IMG}
            src={(post.data.thumbnail || thumbnail) as ImageMetadata}
            alt={`${post.data.title}のサムネイル`}
            loading="eager"
            transition:name={getImgName(post)}
          />
        )
      }
      <!-- TODO:  -->
      <span>{post.data.createdAt}</span>
      <Title>{post.data.title}</Title>
      <Content />
    </article>
    <div class="spacer"></div>
  </main>
</Layout>

<style>
  .spacer {
    height: 1000px;
  }
</style>
