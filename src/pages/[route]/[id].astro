---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import thumbnail from '@/assets/thumbnail.png';
import Back from '@/components/parts/link/Back/index.astro';
import Title from '@/components/parts/Title/index.astro';
import Layout from '@/layouts/Layout/index.astro';

import { getImgName, getPosts } from '@/lib';

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map(post => ({
    params: {
      route: post.data.contentType,
      id: post.id,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <main>
    <Back />
    <article class="markdown-body">
      <Image
        class="post-img"
        src={post.data.thumbnail ?? thumbnail}
        alt={`${post.id}のサムネイル`}
        loading="eager"
        inferSize
        transition:name={getImgName(post)} 
      />
      <span>{post.data.createdAt.toLocaleDateString()}</span>
      <Title>{post.data.title}</Title>
      <Content />
    </article>
  </main>
</Layout>