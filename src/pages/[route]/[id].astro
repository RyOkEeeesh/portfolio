---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import thumbnail from '@/assets/thumbnail.png';
import Layout from '@/layouts/Layout.astro';
import Title from '@/components/Title.astro';
import { getImgName, getPosts } from '@/lib';

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map(post => ({
    params: {
      route: post.data.contentType,
      id: post.id,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <main>
    <button type="button" class="back-link"> ← 戻る </button>
    <article class="markdown-body">
      <Image
        class="post-img"
        src={post.data.thumbnail ?? thumbnail}
        alt={`${post.id}のサムネイル`}
        loading="eager"
        inferSize
        transition:name={getImgName(post)}
      />
      <span>{post.data.createdAt.toLocaleDateString()}</span>
      <Title>{post.data.title}</Title>
      <Content />
    </article>
  </main>
  <script>
    document.addEventListener("astro:page-load", () => {
      document.querySelector(".back-link")?.addEventListener("click", () => {
        history.back();
      });
    });
  </script>
</Layout>