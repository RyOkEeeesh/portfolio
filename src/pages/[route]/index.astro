---
import { ContentsSchema } from '@/schema';

import Layout from '@/layouts/Layout/index.astro';

import Back from '@/components/parts/link/Back/index.astro';
import PostsContainer from '@/components/parts/PostsContainer/index.astro';
import Title from '@/components/parts/Title/index.astro';

import { getPosts } from '@/lib';

export async function getStaticPaths() {
  const allPosts = await getPosts();

  return ContentsSchema.options.map(route => {
    const posts = allPosts.filter(post => post.data.contentType === route);
    posts.sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());

    return {
      params: { route },
      props: { posts },
    };
  });
}

const { route } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`${route}一覧`}>
  <main>
    <Back href="/" />
    <Title>{route}</Title>
    {
      posts.length === 0 ? (
        <p>記事がありません。</p>
      ) : (
        <article>
          <PostsContainer posts={posts} />
        </article>
      )
    }
  </main>
</Layout>
