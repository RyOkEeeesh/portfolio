---
import Post from '@/components/Post/index.astro';
import Title from '@/components/Title/index.astro';
import Layout from '@/layouts/Layout/index.astro';
import { getPosts } from '@/lib';
import { ContentsSchema } from '@/schema/posts';

export async function getStaticPaths() {
  const allPosts = await getPosts();

  return ContentsSchema.options.map(route => {
    const posts = allPosts.filter(post => post.data.contentType === route);
    posts.sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());

    return {
      params: { route },
      props: { posts },
    };
  });
}

const { route } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`${route}一覧`}>
  <main>
    <a href="/">← トップへ戻る</a>
    <Title>{route}</Title>
    {
      posts.length === 0 ? (
        <p>記事がありません。</p>
      ) : (
        <article>
          {posts.map((post) => (
            <Post post={post} />
          ))}
        </article>
      )
    }
  </main>
</Layout>
