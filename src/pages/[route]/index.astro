---
import { ContentsSchema } from '@/schema';

import Layout from '@/layouts/Layout/index.astro';

import Back from '@/components/parts/link/Back/index.astro';
import PostsContainer from '@/components/parts/PostsContainer/index.astro';
import Title from '@/components/parts/Title/index.astro';

import { getPosts } from '@/lib';

export async function getStaticPaths() {
  const allPosts = await getPosts();

  return ContentsSchema.options.map(route => {
    const posts = allPosts.filter(post => post.data.contentType === route);

    return {
      params: { route },
      props: { posts },
    };
  });
}

const { route } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={route}>
  <main class="list-page">
    <Back href="/" />
    <header class="page-header">
      <Title>{route}</Title>
      <span class="count sub">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
    </header>
    {
      posts.length === 0 ? (
        <div class="empty-state sub">No {route} posts yet.</div>
      ) : (
        <section class="posts-section">
          <PostsContainer posts={posts} />
        </section>
      )
    }
  </main>
</Layout>

<style>
  .list-page {
    display: flex;
    flex-direction: column;
  }

  .page-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--clr-border);
  }

  .count {
    font-size: var(--font-size-mut-txt-s);
  }

  .empty-state {
    padding: 3rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px dashed var(--clr-border);
    text-align: center;
    font-size: var(--font-size-mut-txt-m);
  }
</style>
