---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import Layout from '@/layouts/Layout/index.astro';

import Back from '@/components/parts/link/Back/index.astro';
import Title from '@/components/parts/Title/index.astro';

import { getImgName, getPosts } from '@/lib';
import { ELEMENTS } from '@/constants';

import thumbnail from '@/assets/thumbnail.png';

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map(post => ({
    params: {
      route: post.contentType,
      number: post.number,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post); // TODO
---

<Layout title={post.title}>
  <main>
    <Back />
    <article class="markdown-body">
      {typeof (post.thumbnail || thumbnail) === 'string' ? (
        <Image
          class={ELEMENTS.POST_IMG}
          src={(post.thumbnail || thumbnail) as string}
          alt={`${post.title}のサムネイル`}
          width={800}
          height={450}
          loading="eager"
          transition:name={getImgName(post)}
        />
      ) : (
        <Image
          class={ELEMENTS.POST_IMG}
          src={(post.thumbnail || thumbnail) as ImageMetadata}
          alt={`${post.title}のサムネイル`}
          loading="eager"
          transition:name={getImgName(post)}
        />
      )}
      <!-- TODO:  -->
      <span>{post.createdAt}</span>
      <Title>{post.title}</Title>
      <Content />
    </article>
    <div class="spacer"></div>
  </main>
</Layout>

<style>
  .spacer {
    height: 1000px;
  }
</style>
