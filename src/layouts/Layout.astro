---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Temporal } from "@js-temporal/polyfill";
import type { Thing, WithContext } from "schema-dts";

interface Props {
	title?: string;
	description?: string;
	ogp?: string;
	noindex?: boolean;
	jsonld?: WithContext<Thing> | WithContext<Thing>[];
}

const {
	title = "kaji.blog",
	description = "ポートフォリオサイトです。",
	ogp = "/ogp.png", // 1200x630px 推奨
	noindex = false,
	jsonld,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogpURL = new URL(ogp, Astro.site);
const currentYear = Temporal.Now.plainDateISO("Asia/Tokyo").year;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="kaji.blog" />
		<link rel="manifest" href="/site.webmanifest" />

		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogpURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogpURL} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=LINE+Seed+JP:wght@100;400;700;800&family=Noto+Sans+JP:wght@100..900&display=swap" rel="stylesheet">

		<ClientRouter />

		{
			jsonld && (
				<script
					is:inline
					type="application/ld+json"
					set:html={JSON.stringify(jsonld)}
				/>
			)
		}

		<script is:inline>
			const themeKey = 'theme';
			const light = 'light';
			const dark = 'dark';

			const getInitTheme = () =>  localStorage.getItem(themeKey) ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? dark : light);

			const applyTheme = (theme) => {
				document.documentElement.setAttribute(`data-${themeKey}`, theme);
				localStorage.setItem(themeKey, theme);
			};

			applyTheme(getInitTheme());

			document.addEventListener('astro:after-swap', () => {
				applyTheme(getInitTheme());
			});

			document.addEventListener('astro:page-load', () => {
				const btn = document.querySelector('.theme-btn');

				if (!btn || btn.dataset.hasThemeListener) return;
				btn.dataset.hasThemeListener = 'true';

				btn.addEventListener('click', () => {
					const currentTheme = document.documentElement.getAttribute(`data-${themeKey}`);
					const nextTheme = currentTheme === dark ? light : dark;
					applyTheme(nextTheme);
				});
			});
		</script>
	</head>
	<body>
		<header class="center" transition:persist>
			<div class="header-container">
				<h1><a class="top__a" href="/">kaji.blog</a></h1>
				<nav>
					<ul>
						<li><a href="/about">about</a></li>
						<li><a href="/project">project</a></li>
						<li><a href="/blog">blog</a></li>
						<li><a href="/note">note</a></li>
						<li><a href="/tags">tags</a></li>
					</ul>
					<div class="center">
						<button class="theme-btn canter" type="button">
							<span class="theme-icon" />
						</button>
				</div>
				</nav>
			</div>
		</header>
		<div class="contents center">
			<slot />
		</div>
		<footer transition:persist>
			<p>© {currentYear} <a href="https://github.com/RyOkEeeesh/portfolio" target="_blank" rel="noopener noreferrer">kaji</a></p>
		</footer>
	</body>
</html>