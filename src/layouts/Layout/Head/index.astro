---
import { BASE_URL } from '@/constants';

import type { MainLayoutProps } from '@/types/layouts';

import { ClientRouter } from 'astro:transitions';

import Favicon from '@/layouts/Layout/Head/Favicon/index.astro';
import Fonts from '@/layouts/Layout/Head/Fonts/index.astro';
import ThemeScript from '@/layouts/Layout/Head/scripts/ThemeScript/index.astro';
import History from '@/layouts/Layout/Head/scripts/History/index.astro';
import AnimationControl from '@/layouts/Layout/Head/scripts/AnimationControl/index.astro';

interface Props extends MainLayoutProps {}

const {
  title = BASE_URL,
  description = 'ポートフォリオサイトです。',
  ogp = '/ogp.png', // 1200x630px 推奨
  noindex,
  jsonld,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogpURL = new URL(ogp, Astro.site);
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />

  <Favicon />

  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogpURL} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogpURL} />

  <Fonts />
  <ClientRouter />

  {
    jsonld && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(jsonld)}
      />
    )
  }

  <ThemeScript />
  <History />
  <AnimationControl />
</head>