<script>
  import { ContentsSchema } from '@/schema';
  import { ELEMENTS } from '@/constants';

  document.addEventListener('astro:before-preparation', (event) => {
    const fromPath = location.pathname;
    const toPath = event.to.pathname;

    const fromSegments = fromPath.split('/').filter(Boolean);
    const toSegments = toPath.split('/').filter(Boolean);

    const isContentDetail = (segments: string[]) =>
      segments.length >= 2 && ContentsSchema.safeParse(segments[0]).success;

    const shouldAnimate =
      isContentDetail(fromSegments) || isContentDetail(toSegments);

    if (!shouldAnimate) {
      const images = document.querySelectorAll<HTMLElement>(`.${ELEMENTS.POST_IMG}`);
      images.forEach((img) => {
        img.style.viewTransitionName = 'none';
      });
    }
  });
</script>
