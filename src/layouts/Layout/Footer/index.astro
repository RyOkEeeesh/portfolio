---
import 'temporal-polyfill/global';

const currentYear = Temporal.Now.plainDateISO('Asia/Tokyo').year;
---

<footer class="center" transition:persist>
  <div class="footer-inner">
    <p>
      © {currentYear}{' '}
      <a href="https://github.com/RyOkEeeesh/portfolio" target="_blank" rel="noopener noreferrer">kaji</a>
    </p>
  </div>
</footer>

<style>
  footer {
    height: var(--h-footer);
    padding: 0 1.5rem;
    border-top: 1px solid var(--clr-border);
    font-family: var(--font-sub);
    font-size: var(--font-size-mut-txt-s);
    color: var(--clr-footer);
    transition: border-color var(--duration-common);
  }

  .footer-inner {
    width: 100%;
    max-width: var(--w-max-content);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  p {
    text-align: center;
  }

  a:link,
  a:visited {
    color: var(--clr-txt-sub);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-common);
  }

  a:hover {
    color: var(--clr-txt-main);
  }
</style>
