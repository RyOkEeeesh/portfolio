---
import { BASE_URL, ROUTES } from '@/constants';
---

<header class="center" transition:persist>
  <div class="header-container">
    <h1><a href="/">{BASE_URL}</a></h1>
    <nav>
      <ul>
        {
          Object.entries(ROUTES).map(([_, value]) => (
            <li>
              <a href={`/${value}`}>{value}</a>
            </li>
          ))
        }
      </ul>
      <div class="center">
        <button class="theme-btn canter" type="button">
          <span class="theme-icon"></span>
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10;
    width: 100%;
    height: var(--h-header);
    font-family: var(--font-title);
    font-weight: 700;
    background-color: rgb(from var(--clr-bg-main) r g b / 0.8);
    box-shadow: 0 0px 0px var(--clr-shadow);
    backdrop-filter: blur(18);
    -webkit-backdrop-filter: blur(18);
    transition:
      background-color var(--duration-common),
      box-shadow var(--duration-common);

    &.is-scrolled {
      border-color: var(--clr-border);
      box-shadow: 0 2px 4px var(--clr-shadow);
    }
  }

  h1 {
    font-size: clamp(1.5rem, 2vw + 1rem, 2.5rem);
    font-weight: 700;
    opacity: 1;
    transition: opacity 0.15s;

    &:hover {
      opacity: 0.8;
    }
  }

  .header-container {
    width: 100%;
    max-width: var(--w-max-content);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  nav {
    height: var(--h-header);
    display: flex;
    gap: var(--spacing-gap-nav);
    align-items: center;
    font-size: 1.1rem;

    ul {
      text-decoration: none;
      display: flex;
      gap: var(--spacing-gap-nav);
    }
  }

  .theme-btn {
    padding-top: 0.4rem;
  }

  .theme-icon {
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    -webkit-mask: var(--theme-icon) no-repeat center / contain;
    mask: var(--theme-icon) no-repeat center / contain;
    background-color: var(--clr-txt-main);
  }
</style>
