---
import { SITE_DATA } from '@/data';

import GithubIcon from '@/components/parts/image/GithubIcon/index.astro';
import Link from '@/components/parts/link/Link/index.astro';
---

<section class="hero-section">
  <div class="role-badge sub">
    <span class="dot" aria-hidden="true"></span>
    <span>Developer · Student</span>
  </div>
  <Link class="about-card" href="/about">
    <div class="link-content">
      <div class="avatar-wrap">
        <GithubIcon width={72} height={72} />
      </div>
      <div class="about-content">
        <p class="user-name">
          {SITE_DATA.user.name.last}{' '}
          {SITE_DATA.user.name.first}
          <span class="reading sub">{SITE_DATA.user.reading.last} {SITE_DATA.user.reading.first}</span>
        </p>
        <p class="affiliation sub">{SITE_DATA.user.affiliation} · @{SITE_DATA.user.githubId}</p>
      </div>
    </div>
  </Link>
</section>

<style>
  .hero-section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .role-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-mut-txt-s);
    letter-spacing: 0.04em;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--clr-txt-sub);
    opacity: 0.7;
  }

  :global(.about-card) {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-border);
    background-color: var(--clr-bg-surface);
    padding: 1.5rem 1.75rem;
    box-shadow: 0 2px 10px var(--clr-shadow);
    transition:
      border-color var(--duration-common),
      box-shadow var(--duration-common),
      transform var(--duration-common);

    &:hover {
      border-color: var(--clr-border-active);
      transform: translateY(-2px);
    }
  }

  .link-content {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .user-name {
    font-family: var(--font-title);
    font-size: 1.35rem;
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem;
    line-height: 1.3;
  }

  .reading {
    font-size: var(--font-size-mut-txt-s);
    font-weight: 400;
  }

  .affiliation {
    font-size: var(--font-size-mut-txt-s);
  }

  @media (max-width: 640px) {
    :global(.about-card) {
      padding: 1.25rem;
    }

    .link-content {
      gap: 1rem;
    }

    .user-name {
      font-size: 1.15rem;
    }
  }
</style>
