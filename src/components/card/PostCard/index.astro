---
import { fmtDate, getImgName, getPostUrl } from '@/utils';
import { Image } from 'astro:assets';

import type { PostType } from '@/types';

import { ELEMENTS } from '@/constants';

interface Props {
  post: PostType;
}

const { post } = Astro.props;
---

<article class="post-card">
  <a class="card-link" href={getPostUrl(post)}>
    <div class="thumb-wrap">
      <Image
        class={ELEMENTS.POST_IMG}
        src={post.data.thumbnail || '/thumbnail/index.png'}
        alt={`${post.data.title}のサムネイル`}
        width={1200}
        height={630}
        loading="eager"
        transition:name={getImgName(post)}
      />
    </div>
    <div class="card-body">
      <div class="meta-row">
        <time class="date sub" datetime={post.data.createdAt}>{fmtDate(post.data.createdAt)}</time>
        {
          post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.slice(0, 2).map(tag => (
                <span class="tag sub">#{tag.name}</span>
              ))}
            </div>
          )
        }
      </div>
      <h3 class="post-title">{post.data.title}</h3>
      {post.data.description && <p class="post-desc">{post.data.description}</p>}
    </div>
  </a>
</article>

<style>
  .post-card {
    border-radius: var(--radius-md);
    border: 1px solid var(--clr-border);
    background-color: var(--clr-bg-surface);
    overflow: hidden;
    box-shadow: 0 2px 8px var(--clr-shadow);
    transition:
      border-color var(--duration-common),
      box-shadow var(--duration-common),
      transform var(--duration-common);

    &:hover {
      border-color: var(--clr-border-active);
      transform: translateY(-3px);

      :global(.post-img) {
        transform: scale(1.03);
      }
    }
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .thumb-wrap {
    width: 100%;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    background-color: var(--clr-bg-subtle);
    border-bottom: 1px solid var(--clr-border);

    :global(.post-img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1rem 1.15rem 1.15rem;
    flex: 1;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .date {
    font-size: var(--font-size-mut-txt-s);
  }

  .tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.72rem;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background-color: var(--clr-bg-subtle);
    color: var(--clr-txt-sub);
  }

  .post-title {
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-desc {
    font-size: 0.85rem;
    color: var(--clr-txt-sub);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
