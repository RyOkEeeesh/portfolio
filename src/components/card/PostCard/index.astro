---
import { fmtDate, getImgName, getPostUrl } from '@/utils';
import { Image } from 'astro:assets';

import type { PostType } from '@/types';

import { ELEMENTS } from '@/constants';

interface Props {
  post: PostType;
}

const { post } = Astro.props;
---

<div class="">
  <a href={getPostUrl(post)}>
    <div class="">
      <div class="">
        <Image
          class={ELEMENTS.POST_IMG}
          src={post.data.thumbnail || '/thumbnail/index.png'}
          alt={`${post.data.title}のサムネイル`}
          width={1200}
          height={630}
          loading="eager"
          transition:name={getImgName(post)}
        />
      </div>
      <h3>{post.data.title}</h3>
      <p><span>{fmtDate(post.data.createdAt)}</span></p>
    </div>
  </a>
</div>
