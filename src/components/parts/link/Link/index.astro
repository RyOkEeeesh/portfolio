---
import LinkIcon from '@/assets/icon/link.svg';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
---

<div class:list={['link', className]}>
  <a href={href}>
    <div class="container">
      <slot />
      <div class="icon-wrap">
        <LinkIcon class="icon" />
      </div>
    </div>
  </a>
</div>

<style>
  .link {
    --is-hovered: 0;

    &:hover {
      --is-hovered: 1;
    }
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .icon {
    fill: var(--clr-txt-main);
    opacity: calc(0.6 + var(--is-hovered, 0) * 0.4);
    transform: scale(calc(1 + var(--is-hovered, 0) * 0.15));
    transform-origin: left bottom;
    transition:
      fill var(--duration-common),
      opacity var(--duration-common),
      transform var(--duration-common);
  }
</style>
