---
import LinkIcon from '@/assets/icon/link.svg';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
---

<a class:list={['link-about', className]} href={href}>
  <div class="container">
    <slot />
    <div class="icon-wrap">
      <LinkIcon class="icon" />
    </div>
  </div>
</a>

<style>
  .link-about {
    --is-hovered: 0;

    &:hover {
      --is-hovered: 1;
    }
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
  }

  .icon-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .icon {
    width: var(--font-size-mut-txt-m);
    height: var(--font-size-mut-txt-m);
    fill: var(--clr-txt-main);
    opacity: calc(0.6 + var(--is-hovered, 0) * 0.4);
    transform: scale(calc(1 + var(--is-hovered, 0) * 0.15));
    transform-origin: left bottom;
    transition:
      fill var(--duration-common),
      opacity var(--duration-common),
      transform var(--duration-common);
  }
</style>
