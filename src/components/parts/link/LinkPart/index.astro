---
import LinkIcon from '@/assets/icon/link.svg';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
---

<div class:list={["linkPart", className]}>
  <a href={href}>
    <div class="container">
      <slot />
      <div class="icon-wrap">
        <LinkIcon class="icon" />
      </div>
    </div>
  </a>
</div>

<style>
  .linkPart {
    --is-hovered: 0;

    &:hover {
      --is-hovered: 1;
    }
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .icon {
    fill: var(--clr-txt-main);
    opacity: calc(0.6 + var(--is-hovered, 0) * 0.4); 
    transform: scale(calc(1 + var(--is-hovered, 0) * 0.1)); 
    transform-origin: left bottom;
    transition: 
      fill 0.15s ease,
      opacity 0.15s ease,
      transform 0.15s ease;
  }
</style>