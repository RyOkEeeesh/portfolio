---
import BackIcon from '@/assets/icon/back.svg';

const { route } = Astro.params;

interface Props {
  href?: string;
}

const { href } = Astro.props;
---

<div class="back">
  <a class="link" href={href || '/'} data-href={href} data-route={route}>
    <BackIcon class="icon" />
  </a>
</div>

<script>
  import { PREV_URL } from '@/constants';

  document.addEventListener('astro:page-load', () => {
    const back = document.querySelector('.link') as HTMLAnchorElement | null;

    if (back?.dataset.href || !back) return;

    const referrer = sessionStorage.getItem(PREV_URL);
    const defaultRoute = `/${back.dataset.route ?? ''}`;

    back.href = referrer ?? defaultRoute;
  });
</script>

<style>
  .back {
    overflow: hidden;
    display: inline-block;
    border-radius: 50%;
    transition: background-color 0.2s ease-out;
    margin-bottom: 2rem;
  }

  .back:hover {
    background-color: var(--clr-border);
  }
</style>
