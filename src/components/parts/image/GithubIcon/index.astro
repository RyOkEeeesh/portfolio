---
import { Image } from 'astro:assets';

interface Props {
  width?: number;
  height?: number;
}

const { width = 100, height = 100 } = Astro.props;

const IconURL = 'https://avatars.githubusercontent.com/u/169122209';
---

<Image
  class="icon"
  src={IconURL}
  alt="Github icon"
  width={width}
  height={height}
  loading="eager"
  transition:name="github-icon"
/>

<style>
  .icon {
    border-radius: 50%;
  }
</style>
