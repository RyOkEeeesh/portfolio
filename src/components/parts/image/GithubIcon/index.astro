---
import { Image } from 'astro:assets';

interface Props {
  width?: number;
  height?: number;
}

const { width = 84, height = 84 } = Astro.props;

const IconURL = 'https://avatars.githubusercontent.com/u/169122209';
---

<Image
  class="icon"
  src={IconURL}
  alt="Github icon"
  width={width}
  height={height}
  loading="eager"
  transition:name="github-icon"
/>

<style>
  .icon {
    border-radius: 50%;
    border: 1px solid var(--clr-border);
    background-color: var(--clr-bg-subtle);
    flex-shrink: 0;
  }
</style>
