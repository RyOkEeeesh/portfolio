---
import { Image } from 'astro:assets';

import type { PostType } from '@/types';

import { getImgName, getPostUrl } from '@/lib';
import { ELEMENTS } from '@/constants';

import thumbnail from '@/assets/thumbnail.png';

interface Props {
  post: PostType;
}

const { post } = Astro.props;
---

<div class="">
  <a href={getPostUrl(post)}>
    <div class="">
      <div class="">
        {typeof (post.thumbnail || thumbnail) === 'string' ? (
          <Image
            class={ELEMENTS.POST_IMG}
            src={(post.thumbnail || thumbnail) as string}
            alt={`${post.title}のサムネイル`}
            width={800}
            height={450}
            loading="eager"
            transition:name={getImgName(post)}
          />
        ) : (
          <Image
            class={ELEMENTS.POST_IMG}
            src={(post.thumbnail || thumbnail) as ImageMetadata}
            alt={`${post.title}のサムネイル`}
            loading="eager"
            transition:name={getImgName(post)}
          />
        )}
      </div>
      <h3>{post.title}</h3>
      <p><span>{post.createdAt}</span></p>
    </div>
  </a>
</div>
