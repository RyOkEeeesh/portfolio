---
import LinkIcon from '@/components/parts/link/LinkPart/index.astro';

import Title from '@/components/parts/Title/index.astro';
import type { PostsType } from '@/types';

interface Props {
  title: string;
  href: string;
}

const { title, href } = Astro.props;
---

<section class="">
  <div class="title-content">
    <Title>{title}</Title>
    <LinkIcon href={href}><span class="link-text">view all</span></LinkIcon>
  </div>
  <div class="">
    <slot />
  </div>
</section>

<style>
  .title-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }

  .link-text {
    opacity: calc(0.6 + var(--is-hovered, 0) * 0.4); 
    transition: opacity 0.15s ease;
  }
</style>