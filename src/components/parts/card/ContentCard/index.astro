---
import LinkIcon from '@/components/parts/link/LinkPart/index.astro';
import Title from '@/components/parts/Title/index.astro';
import type { ContentsType } from '@/schema';

interface Props {
  route: ContentsType | 'tags';
}

const { route } = Astro.props;
---

<section class="">
  <div class="title-content">
    <Title>{route}</Title>
    <LinkIcon href={route}><span class="link-text">view all</span></LinkIcon>
  </div>
  <div class="">
    <slot />
  </div>
</section>

<style>
  .title-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    border-bottom: 2px solid var(--clr-border);
    padding: 0.5rem 0.25rem;
  }

  .link-text {
    opacity: calc(0.6 + var(--is-hovered, 0) * 0.4); 
    transition: opacity 0.15s ease;
  }
</style>