---
import GithubIcon from '@/components/parts/image/GithubIcon/index.astro';
import LinkPart from '@/components/parts/link/LinkPart/index.astro';
---

<section>
  <span class="sub-txt">Developer · Student</span>
  <LinkPart class="about-card" href="/about">
    <div class="link-content">
      <div class="content">
        <GithubIcon />
      </div>
      <div class="about-content">
        <p>加地 良寅 <span>Kaji Ryoin</span></p>
        <p>HAL東京</p>
        </div>
      </div>
  </LinkPart>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  :global(.about-card) {
    overflow: hidden;
    border-radius: 8px;
    border: 2px solid var(--clr-border); 
    transition: border-color 0.15s ease;
    padding: 0.5rem 1rem;

    &:has(a:hover) {
      border-color: var(--clr-border-active);
    }
  }

  .link-content {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 24px;
  }
</style>