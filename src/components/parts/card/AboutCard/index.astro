---
import GithubIcon from '@/components/parts/image/GithubIcon/index.astro';
import Link from '@/components/parts/link/Link/index.astro';

import { SITE_DATA } from '@/data';
---

<section>
  <span class="sub">Developer · Student</span>
  <Link class="about-card" href="/about">
    <div class="link-content">
      <div class="content">
        <GithubIcon />
      </div>
      <div class="about-content">
        <p>{SITE_DATA.user.name.last} {SITE_DATA.user.name.first}<span>{SITE_DATA.user.reading.last} {SITE_DATA.user.reading.first}</span></p>
        <p>{SITE_DATA.user.affiliation}</p>
      </div>
    </div>
  </Link>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  :global(.about-card) {
    display: block;
    overflow: hidden;
    border-radius: 8px;
    border: 2px solid var(--clr-border);
    transition: border-color var(--duration-common);
    padding: 0 1rem;

    &:hover {
      border-color: var(--clr-border-active);
    }
  }

  .sub {
    font-size: var(--font-size-mut-txt-m);
  }

  .link-content {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 2rem 1rem;
  }
</style>
