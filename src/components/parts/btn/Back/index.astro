---
const { route } = Astro.params;

interface Props {
	href?: string;
}

const { href } = Astro.props;
---

<a class="back" href={href || '/'} data-href={href} data-route={route} />

<script>
  import { PREV_URL } from "@/constants";
import { navigate } from "astro:transitions/client";

  document.addEventListener("astro:page-load", () => {
    const back = document.querySelector(".back") as HTMLAnchorElement | null;

    if (back?.dataset.href || !back) return;

    const referrer = sessionStorage.getItem(PREV_URL);
    const defaultRoute = `/${back.dataset.route ?? ''}`;

    back.href = referrer ?? defaultRoute;
  });
</script>

<style>
  .back {
    display: block;
    position: relative;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    margin-bottom: 2rem;
    transition: background-color 0.2s ease-out;
  }
  
  .back::before {
    position: absolute;
    content: "";
    top: 50%;
    left: 68%;
    width: 0.8rem;
    height: 0.8rem;
    transform: translate(-68%, -50%) rotate(-45deg);
    border-top: 0.2rem solid var(--clr-txt-main);
    border-left: 0.2rem solid var(--clr-txt-main);
    z-index: 10;
  }
  
  .back:hover {
    background-color: var(--clr-border);
  }
</style>