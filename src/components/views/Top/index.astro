---
import { ContentsSchema } from '@/schema/posts';

import AboutCard from '@/components/card/AboutCard/index.astro';
import ContentCard from '@/components/views/Top/ContentCard/index.astro';
---

<main class="top-main">
  <AboutCard />
  <div class="sections">
    {ContentsSchema.options.map(route => <ContentCard route={route} />)}
  </div>
</main>

<style>
  .top-main {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
</style>
