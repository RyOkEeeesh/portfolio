---
import type { ContentsType } from '@/types';

import PostContainer from '@/components/parts/PostsContainer/index.astro';
import Title from '@/components/views/Top/Title/index.astro';

import { getPublishedPosts } from '@/lib';

interface Props {
  route: ContentsType;
}

const { route } = Astro.props;

const posts = await getPublishedPosts(route, 3);
---

<section class="content-section">
  <Title route={route} />
  {posts.length === 0 ? <div class="empty-state sub">No {route} posts yet.</div> : <PostContainer posts={posts} />}
</section>

<style>
  .content-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .empty-state {
    padding: 2rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px dashed var(--clr-border);
    text-align: center;
    font-size: var(--font-size-mut-txt-s);
  }
</style>
